{
  "name": "@bitsocial/tipping-challenge",
  "version": "0.2.1",
  "description": "Standalone tipping challenge for pkc-js: verifies ERC-20, ERC-721 and native coin tips attached to replies, implementing the tipping/v1 contract",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepare": "husky",
    "release": "HUSKY=0 release-it --config config/.release-it.json"
  },
  "keywords": [
    "bitsocial",
    "pkc",
    "challenge",
    "tipping",
    "evm",
    "viem"
  ],
  "author": "Rinse",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitsocialnet/tipping-challenge.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "viem": "2.55.19"
  },
  "devDependencies": {
    "@commitlint/cli": "20.4.3",
    "@commitlint/config-conventional": "20.4.3",
    "@pkcprotocol/pkc-js": "0.0.152",
    "@release-it/conventional-changelog": "10.0.5",
    "@types/node": "25.3.5",
    "husky": "9.1.7",
    "release-it": "19.2.4",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "@pkcprotocol/pkc-js": ">=0.0.152"
  },
  "peerDependenciesMeta": {
    "@pkcprotocol/pkc-js": {
      "optional": true
    }
  }
}
